{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Persistence": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=jxserver-dev.db",
    "AutoInitializeDatabase": true
  },
  "GameAssets": {
    "ServerRootPath": "d:\\Projects\\jx-linux-bin\\server1",
    "GatewayRootPath": "d:\\Projects\\jx-linux-bin\\gateway",
    "DataDirectory": "d:\\Projects\\jx-server\\data",
    "ArtifactsDirectory": "d:\\Projects\\jx-server\\artifacts",
    "PreferBinarySnapshots": true,
    "DefaultFallbackStarterVillageMapId": 53,
    "FallbackUnloadedStarterVillage": true,
    "EagerObstacleLoadMapIds": [ 53, 54, 70, 74, 199 ]
  },
  "Application": {
    "AutoProvisionAccounts": true,
    "AdvertisedGameServerHost": "127.0.0.1",
    "AdvertisedGameServerPort": 6666,
    "HandoffTicketTtlSeconds": 30,
    "HeartbeatTimeoutSeconds": 15
  },
  "ZoneEngine": {
    "TicksPerSecond": 18,
    "HeartbeatIntervalSeconds": 5,
    "HeartbeatTimeoutSeconds": 15
  },
  "LegacyGateway": {
    "BindAddress": "0.0.0.0",
    "BishopPort": 5622,
    "GameServerPort": 6666
  }
}
